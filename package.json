{
  "name": "@reachfive/identity-core",
  "version": "1.42.0",
  "description": "ReachFive Identity Web Core SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ReachFive/identity-web-core-sdk"
  },
  "author": "ReachFive",
  "main": "cjs/main.js",
  "module": "es/main.js",
  "types": "es/main.d.ts",
  "scripts": {
    "clean": "rm -rf cjs es umd",
    "prebuild": "npm run clean",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "test": "jest --silent",
    "watch:test": "jest --silent --watch",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:umd": "node scripts/smoke-umd.cjs"
  },
  "dependencies": {
    "@types/cordova-plugin-inappbrowser": "2.0.0",
    "jose": "^5.10.0",
    "winchan": "0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/google-one-tap": "1.1.0",
    "@types/jest": "28.1.3",
    "@types/lodash": "4.14.161",
    "@types/webappsec-credential-management": "^0.6.8",
    "eslint": "^9.0.0",
    "eslint-plugin-compat": "^7.0.0",
    "globals": "^15.0.0",
    "jest": "28.1.3",
    "jest-environment-jsdom": "^28.1.3",
    "jest-fetch-mock": "3.0.3",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^28.0.8",
    "ts-node": "^10.9.2",
    "tslib": "2.0.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.0.0",
    "whatwg-fetch": "^3.4.1"
  },
  "files": [
    "cjs",
    "es",
    "umd"
  ]
}
